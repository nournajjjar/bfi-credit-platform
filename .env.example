# PostgreSQL (pgvector-enabled)
PG_HOST=localhost
PG_PORT=5432
PG_DB=tunisie_industrie
PG_USER=postgres
PG_PASSWORD=

# LLM provider (Azure AI Foundry — Phi-4)
OPENAI_API_KEY=
AZURE_ENDPOINT=
OPENAI_MODEL=Phi-4
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small

# Web research
TAVILY_API_KEY=

# Auth
JWT_SECRET=

# Observability (optional)
LAMINAR_API_KEY=

# Research parameters
MAX_PAGES=20
MAX_TAVILY_RESULTS=8
MAX_PAGE_CHARS=4000

# API
API_PORT=8000
LOG_LEVEL=INFO
REPORT_OUTPUT_DIR=database/output
